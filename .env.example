# Cloud Function (getTotalAmount)
# Desarrollo (functions-framework local, ver functions/package.json -> "start")
VITE_API_URL=http://localhost:8080
# Producción (URL de la función ya desplegada)
# VITE_API_URL=https://us-central1-gestion-20.cloudfunctions.net

# Firebase Web App config
# Firebase Console > Configuración del proyecto > General > "Tus apps" > app Web > Config
# (No son secretas: es la config pública del cliente. La seguridad real la dan las
# reglas de Firestore/Storage y la allowlist, no ocultar estos valores.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
